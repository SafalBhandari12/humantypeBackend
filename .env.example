# TypeRacer Backend Environment Configuration

# Server Configuration
PORT=3000
NODE_ENV=development

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Race Configuration
DEFAULT_COUNTDOWN_MS=3000
DEFAULT_DURATION_MS=60000
MAX_PLAYERS_PER_RACE=8

# Security Configuration
# JWT_SECRET=your-secret-key-here
# CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info

# Rate Limiting
MAX_PROGRESS_UPDATES_PER_SECOND=20
HEARTBEAT_INTERVAL_MS=30000

# Anti-cheat
MAX_CHARS_PER_SECOND=10
MIN_PROGRESS_INTERVAL_MS=50
